# Producción: Caddy sirve la SPA y hace de proxy de /api con el MISMO origen (research R-14, R-15).
# HTTPS automático: certificado ACME (Let's Encrypt) para {$DOMINIO} y redirección 308 de HTTP a
# HTTPS. Con TLS_MODO=internal se usa la CA interna de Caddy (simulación local).

{$DOMINIO} {
	import /etc/caddy/tls-{$TLS_MODO}.caddy

	encode zstd gzip

	# Rutas de PDF (003, research R-8; presupuestos en 005): traen su propia CSP desde la API, que
	# deja abrirlas en el visor integrado del navegador (object-src 'self'). La CSP de la SPA no se
	# les aplica.
	@nopdf {
		not path_regexp ^/api/v1/(facturas|presupuestos)/(listado|[^/]+)/pdf$
	}

	header @nopdf Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		@recursos path /assets/*
		header @recursos Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
