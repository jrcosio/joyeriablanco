# =============================================================================
# Joyería Blanco — plantilla de configuración
# Copia este fichero a `.env` y CAMBIA TODAS LAS CONTRASEÑAS. `.env` no se versiona.
# =============================================================================

# Entorno: desarrollo | e2e | test | produccion
ENTORNO=desarrollo

# --- PostgreSQL ---------------------------------------------------------------
# Superusuario de arranque: solo lo usa infra/db/init/01-roles.sh al crear la BD.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-superusuario
POSTGRES_DB=postgres

# Roles de la aplicación (research R-11)
#   jb_owner: dueño del esquema, ejecuta las migraciones.
#   jb_app:   solo DML, lo usa la API.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=joyeriablanco
DB_OWNER_USER=jb_owner
DB_OWNER_PASSWORD=cambia-owner
DB_APP_USER=jb_app
DB_APP_PASSWORD=cambia-app
# Alternativa: URLs completas (tienen prioridad sobre los campos anteriores)
# DATABASE_URL_APP=postgresql+psycopg://jb_app:***@db:5432/joyeriablanco
# DATABASE_URL_OWNER=postgresql+psycopg://jb_owner:***@db:5432/joyeriablanco

# --- Seguridad ----------------------------------------------------------------
# Origen desde el que se sirve la web (comprobación de Origin, research R-6)
ORIGEN_PERMITIDO=http://localhost:5173
# En desarrollo (http://localhost) la cookie no puede ser Secure; en producción SIEMPRE true
SESION_COOKIE_SEGURA=false
SESION_INACTIVIDAD_MINUTOS=30
SESION_DURACION_MAXIMA_HORAS=10
BLOQUEO_INTENTOS=5
BLOQUEO_MINUTOS=15
LIMITE_ORIGEN_INTENTOS=20
LIMITE_ORIGEN_VENTANA_MINUTOS=10
CONTRASENA_TEMPORAL_HORAS=72

# --- Sistema informático de facturación (research R-5 de 002) ------------------
# Se copian en el bloque SistemaInformatico de cada registro de facturación, que es INALTERABLE.
# Los valores por defecto son ficticios: en producción la API no arranca sin el productor real
# (pendiente de la declaración responsable, TODO(DECLARACION_RESPONSABLE)).
# SIF_PRODUCTOR_NOMBRE=
# SIF_PRODUCTOR_NIF=
# SIF_NOMBRE_SISTEMA=Joyería Blanco Gestión
# SIF_ID_SISTEMA=JB
# SIF_NUMERO_INSTALACION=1

# --- AEAT (003, research R-3) ---------------------------------------------------
# Entorno de la dirección de cotejo del QR de las facturas impresas: pruebas | produccion.
# Vacío equivale a `pruebas` fuera de producción. En producción es OBLIGATORIO: `pruebas` mientras
# se valida la integración y `produccion` al facturar de verdad.
# AEAT_ENTORNO=pruebas

# --- Producción (docker-compose.prod.yml) ------------------------------------
# Dominio público servido por Caddy con certificado automático
DOMINIO=joyeria.example.com
# TLS_MODO: acme (Let's Encrypt, producción real) | internal (simulación local)
TLS_MODO=acme
